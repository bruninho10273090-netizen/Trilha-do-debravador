# Conexão com o PostgreSQL
DATABASE_URL=postgres://trilha:trilha@localhost:5432/trilha
# Porta e host da API
PORT=3000
HOST=0.0.0.0
# Origens liberadas no CORS, separadas por vírgula (vazio = mesma origem)
CORS_ORIGINS=
# Validade da sessão em dias
SESSION_DAYS=30
# Serve o index.html do app na raiz (true/false)
SERVE_FRONTEND=true
# Limite de tentativas em login/cadastro (desligue só em testes)
RATE_LIMIT=true
